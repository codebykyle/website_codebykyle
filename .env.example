# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Contact form delivery — SMTP. If NUXT_SMTP_HOST is unset, the endpoint
# logs incoming messages to the server console and returns success (handy
# for local dev). Set all of these in production.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
# 'true' forces TLS (port 465). Otherwise STARTTLS is auto-negotiated.
NUXT_SMTP_SECURE=
# Where contact-form messages are delivered.
NUXT_CONTACT_TO=hi@codebykyle.com
# The From: address. Many providers require this to match an authenticated
# sender or verified domain.
NUXT_CONTACT_FROM=

# Newsletter signups go to this MailerLite group. If the key is unset, the
# endpoint logs the address and returns success.
NUXT_MAILERLITE_API_KEY=
NUXT_MAILERLITE_GROUP=codebykyle
